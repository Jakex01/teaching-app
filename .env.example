# Used by `docker compose --profile app up` (the full stack runs in production mode).
# Generate each value with: openssl rand -base64 32
SYNC_SECRET=
SESSION_SECRET=

# Sign in with Google (optional). From Google Cloud → Google Auth Platform → Clients.
# Redirect URI to register there: <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true = anyone with a Google account can create a teacher account. Default: only existing teachers.
ALLOW_GOOGLE_SIGNUP=false

# E-mail for invitations and password resets. Without it, docker compose uses Mailpit (http://localhost:8025).
# Production, e.g. Amazon SES:  smtps://SMTP_USER:SMTP_PASSWORD@email-smtp.eu-central-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM=Doodle Board <no-reply@doodleboard.local>

# AI hints on task cards (optional). Free key: aistudio.google.com → Get API key.
AI_PROVIDER=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
