# Production settings. On the server: /opt/doodle/.env (chmod 600), never in git.
# Generate secrets with: openssl rand -base64 32

# Addresses. Before the domain is bought: <ip-with-dashes>.sslip.io (e.g. app.34-118-116-108.sslip.io).
APP_HOST=app.example.pl
SYNC_HOST=sync.example.pl

DB_PASSWORD=
SYNC_SECRET=
SESSION_SECRET=

# E-mail (invitations, password reset)
SMTP_URL=smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
MAIL_FROM=Doodle Board <user@gmail.com>

# Sign in with Google (optional). Redirect URI to register: https://<APP_HOST>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_GOOGLE_SIGNUP=false

# AI hints (optional)
AI_PROVIDER=gemini
GEMINI_API_KEY=
